  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#72858F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSDoc tags",
      "scope": [
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc"
      ],
      "settings": {
        "foreground": "#8F59B3"
      }
    },
    {
      "name": "JSDoc types",
      "scope": [
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#D62750"
      }
    },
    {
      "name": "JSDoc names",
      "scope": [
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#597078"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8F59B3"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.other.template",
        "keyword.other.substitution",
        "punctuation.accessor.optional",
        "punctuation.definition.template-expression",
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#009098"
      }
    },
    {
      "name": "Variables, parameters, properties",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "variable.other.readwrite.alias",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#597078"
      }
    },
    {
      "name": "Functions, methods, this, decorators",
      "scope": [
        "entity.name.function",
        "variable.function",
        "support.function",
        "keyword.other.special-method",
        "variable.language",
        "meta.decorator",
        "punctuation.decorator",
        "meta.decorator variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#5171A6"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#D62750"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#BA5100"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "string.regexp keyword.other"
      ],
      "settings": {
        "foreground": "#7C4DFF"
      }
    },
    {
      "name": "Regular expression anchors",
      "scope": [
        "string.regexp keyword.control.anchor"
      ],
      "settings": {
        "foreground": "#009098"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other.color",
        "support.constant",
        "keyword.other.unit",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#2C7896"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#4B71AE"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#009098"
      }
    },
    {
      "name": "JSX attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#587B15"
      }
    },
    {
      "name": "JSX text and embedded braces",
      "scope": [
        "meta.jsx.children",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#597078"
      }
    },
    {
      "name": "HTML attributes and CSS selectors",
      "scope": [
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#A46000"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#63718A"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#5171A6"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#D72929"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#7C4DFF"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#587B15",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D62750",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D62750",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown bold italic",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "foreground": "#D62750",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#7C4DFF"
      }
    },
    {
      "name": "Markdown quotes, fences, separators",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote.begin.markdown",
        "fenced_code.block.language",
        "punctuation.definition.markdown",
        "meta.separator.markdown"
      ],
      "settings": {
        "foreground": "#72858F"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "string.other.link.title.markdown",
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#5171A6"
      }
    },
    {
      "name": "Markdown link targets",
      "scope": [
        "markup.underline.link",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#A46000"
      }
    },
    {
      "name": "Markdown list markers",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#009098"
      }
    },
    {
      "name": "Markdown underline",
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#587B15"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#D72929"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7C4DFF"
      }
    },
    {
      "name": "Diff headers",
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#5171A6"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#D62750",
    "interface": "#D62750",
    "enum": "#D62750",
    "type": "#D62750",
    "typeParameter": "#D62750",
    "namespace": "#D62750",
    "function": "#5171A6",
    "method": "#5171A6",
    "enumMember": "#2C7896",
    "variable": "#597078",
    "parameter": "#597078",
    "property": "#597078",
    "*.deprecated": {
      "strikethrough": true
    }
  }
