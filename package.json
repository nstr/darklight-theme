{
  "name": "darklight-theme",
  "displayName": "Darklight",
  "description": "A dark frame around a light editor: deep blue workbench, white editor, readable Material-inspired syntax.",
  "version": "0.1.1",
  "publisher": "nstr",
  "author": "Nick Nesterov",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1B1E2B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nstr/darklight-theme"
  },
  "bugs": {
    "url": "https://github.com/nstr/darklight-theme/issues"
  },
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "light",
    "material",
    "palenight"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Darklight",
        "uiTheme": "vs-dark",
        "path": "./themes/darklight-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "package": "npm run build && npm run check && vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^0.10.1"
  }
}
